@page "/"
@implements IDisposable
@inject IGitHubClient GitHub
@inject IPresetStore Store
@inject GitPusher Pusher
@inject IJSRuntime JS

<PageTitle>Contribution Art</PageTitle>

<main class="container page px-3 pt-4 pb-5">
    <header class="row justify-content-between align-items-start gy-2 mb-4">
        <div class="col">
            <h1 class="fs-3 fw-bold mb-0">Contribution Art</h1>
        </div>
        <div class="col-auto">
            <div class="btn-group btn-group-sm" role="group" aria-label="Color theme">
                @foreach (var mode in ThemeModes)
                {
                    <input type="radio" class="btn-check" name="theme-mode" id="theme-@mode" value="@mode"
                           checked="@(_themeMode == mode)" @onchange="OnThemeModeChangedAsync" />
                    <label class="btn btn-outline-secondary text-capitalize" for="theme-@mode">@mode</label>
                }
            </div>
        </div>
        <div class="col-12">
            <p class="text-body-secondary mt-3 mb-3">
                Paint on a copy of your contribution calendar, then push it as backdated empty commits to a
                dedicated repository. The repository gets a README saying it is art, so nothing is misleading.
            </p>
            <div class="alert alert-warning mb-0" role="alert">
                This application is in single-user mode only. Anyone connected to the same running app shares the
                user presets and can save new ones. That's fine for running it locally, but add access control
                before hosting it publicly.
            </div>
        </div>
    </header>

    <section class="card rounded-3 mb-3">
        <div class="card-body">
            <h2 class="fs-6 fw-bold mb-3">1 · Connect</h2>
            <div class="row row-cols-1 row-cols-md-2 g-3 mb-3">
                <div class="col">
                    <label class="form-label fw-semibold mb-1" for="token">GitHub token</label>
                    <input id="token" class="form-control form-control-sm" type="password" @bind="_token" placeholder="github_pat_…" autocomplete="off" />
                    <div class="form-text">Fine-grained token, access to the art repository only, permission <em>Contents: Read and write</em>.</div>
                </div>
                <div class="col">
                    <label class="form-label fw-semibold mb-1" for="repository">Repository name</label>
                    <input id="repository" class="form-control form-control-sm" @bind="_repository" placeholder="contribution-graphics" />
                    <div class="form-text">Create it on GitHub first: new, empty, no README.</div>
                </div>
            </div>
            <button class="btn btn-primary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_token))" @onclick="ConnectAsync">
                @(_connected ? "Reconnect" : "Connect")
            </button>

            @if (_connected)
            {
                <div class="row row-cols-1 row-cols-md-2 g-3 mt-0">
                    <div class="col">
                        <label class="form-label fw-semibold mb-1" for="owner">Owner</label>
                        <input id="owner" class="form-control form-control-sm" @bind="_owner" />
                    </div>
                    <div class="col">
                        <label class="form-label fw-semibold mb-1" for="author-name">Author name</label>
                        <input id="author-name" class="form-control form-control-sm" @bind="_authorName" />
                    </div>
                    <div class="col">
                        <label class="form-label fw-semibold mb-1" for="author-email">Author email</label>
                        <input id="author-email" class="form-control form-control-sm" @bind="_authorEmail" />
                        <div class="form-text">Must be linked to your account, or commits won't show. The no-reply address always works.</div>
                    </div>
                    <div class="col">
                        <label class="form-label fw-semibold mb-1" for="multiplier">Commits per level</label>
                        <input id="multiplier" class="form-control form-control-sm" type="number" min="1" max="50" @bind="_multiplier" />
                        <div class="form-text">Your busiest day: @_maxDaily contributions. Shades are relative to it, so dark pixels need more commits.</div>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="card rounded-3 mb-3">
        <div class="card-body">
            <h2 class="fs-6 fw-bold mb-3">2 · Paint</h2>

            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <div class="swatches d-flex gap-1" role="radiogroup" aria-label="Brush level">
                    @for (var l = 0; l <= ContributionGrid.MaxLevel; l++)
                    {
                        var level = l;
                        <button class="swatch border rounded p-0 text-body-secondary l@(level) @(_brush == level ? "active" : "")"
                                title="@(level == 0 ? "Eraser" : $"Level {level}")"
                                @onclick="() => _brush = level">@(level == 0 ? "✕" : "")</button>
                    }
                </div>

                <div class="d-flex align-items-center gap-2">
                    <select class="form-select form-select-sm w-auto" @bind="_preset">
                        @foreach (var preset in Store.Presets)
                        {
                            <option value="@preset.Name">@preset.Name</option>
                        }
                    </select>
                    <button class="btn btn-secondary btn-sm" @onclick="StampPreset">Stamp</button>
                    <button class="btn btn-outline-secondary btn-sm" title="Read saved presets from the file again" @onclick="ReloadPresets">Reload</button>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <input class="form-control form-control-sm medium" @bind="_newPresetName" @bind:event="oninput"
                           maxlength="@PresetValidator.MaxNameLength" placeholder="Preset name" />
                    <button class="btn btn-secondary btn-sm text-nowrap" disabled="@(PixelCount == 0 || string.IsNullOrWhiteSpace(_newPresetName))" @onclick="SavePreset">Save as preset</button>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <input class="form-control form-control-sm medium text-uppercase" @bind="_text" @bind:event="oninput" maxlength="13" placeholder="TEXT" />
                    <button class="btn btn-secondary btn-sm" disabled="@(string.IsNullOrWhiteSpace(_text))" @onclick="StampText">Write</button>
                </div>

                <label class="d-flex align-items-center gap-2 text-nowrap">
                    at week
                    <input class="form-control form-control-sm narrow" type="number" min="1" max="@ContributionGrid.Weeks" @bind="_startWeek" />
                </label>

                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _grid.Clear()">Clear</button>
            </div>

            <div class="overflow-x-auto pb-1">
                <div class="d-inline-block user-select-none" @onmouseup="StopPaint" @onmouseleave="StopPaint">
                    <div class="months">
                        @foreach (var w in WeekIndexes)
                        {
                            <span>@MonthLabel(w)</span>
                        }
                    </div>
                    <div class="d-flex">
                        <div class="weekdays">
                            <span></span><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span>
                        </div>
                        <div class="grid">
                            @foreach (var w in WeekIndexes)
                            {
                                foreach (var d in DayIndexes)
                                {
                                    var level = _grid.Get(w, d);
                                    var future = _grid.IsFuture(w, d);
                                    <div class="cell l@(level) @(future ? "future" : "")"
                                         title="@CellTitle(w, d, level, future)"
                                         @onmousedown="() => StartPaint(w, d)" @onmousedown:preventDefault="true"
                                         @onmouseenter="() => ContinuePaint(w, d)"></div>
                                }
                            }
                        </div>
                    </div>
                    <div class="week-numbers">
                        @foreach (var w in WeekIndexes)
                        {
                            <span>@WeekNumberLabel(w)</span>
                        }
                    </div>
                </div>
            </div>
            <p class="text-body-secondary mt-2 mb-0">Click or drag to paint. Clicking a cell that already has the brush level clears it.</p>
            @if (_presetMessage is not null)
            {
                <p class="mt-3 mb-0 @(_presetMessageIsError ? "text-danger" : "text-success")">@_presetMessage</p>
            }
        </div>
    </section>

    <section class="card rounded-3 mb-3">
        <div class="card-body">
            <h2 class="fs-6 fw-bold mb-3">3 · Publish</h2>
            <p class="text-body-secondary mb-0">
                <strong class="text-body">@PixelCount</strong> pixels · <strong class="text-body">@TotalCommits</strong> commits
                · graph from @_grid.StartDate.ToString("d MMM yyyy", CultureInfo.InvariantCulture)
                to @_grid.Today.ToString("d MMM yyyy", CultureInfo.InvariantCulture)
            </p>
            @if (TotalCommits > 5000)
            {
                <p class="text-warning mt-2 mb-0">That's a lot of commits. Consider lowering “commits per level”.</p>
            }

            <div class="d-flex flex-wrap gap-2 mt-3">
                <button class="btn btn-primary btn-sm" disabled="@(!CanPush)" @onclick="PushAsync">Push to GitHub</button>
                <button class="btn btn-secondary btn-sm" disabled="@(PixelCount == 0 || string.IsNullOrWhiteSpace(_owner))" @onclick="DownloadScriptAsync">
                    Download bash script
                </button>
                @if (_busy && _cts is not null)
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => _cts.Cancel()">Cancel</button>
                }
            </div>

            @if (_status is not null)
            {
                <p class="mt-3 mb-0">@_status</p>
            }
            @if (_error is not null)
            {
                <p class="text-danger mt-3 mb-0">@_error</p>
            }
            @if (_resultUrl is not null)
            {
                <p class="text-success mt-3 mb-0">
                    Done. See <a class="text-reset fw-semibold" href="@_resultUrl" target="_blank" rel="noopener">@_owner/@_repository</a>.
                    The graph can take a few minutes (sometimes up to a day) to update.
                </p>
            }
        </div>
    </section>
</main>

@code {
    private static readonly int[] WeekIndexes = Enumerable.Range(0, ContributionGrid.Weeks).ToArray();
    private static readonly int[] DayIndexes = Enumerable.Range(0, ContributionGrid.Days).ToArray();
    private const string DefaultThemeMode = "auto";
    private static readonly string[] ThemeModes = [DefaultThemeMode, "light", "dark"];

    private readonly ContributionGrid _grid = new(DateOnly.FromDateTime(DateTime.UtcNow));

    // Appearance
    private string _themeMode = DefaultThemeMode;

    // Connection
    private string _token = "";
    private string _repository = "contribution-graphics";
    private string _owner = "";
    private string _authorName = "";
    private string _authorEmail = "";
    private int _multiplier = 1;
    private int _maxDaily;
    private bool _connected;

    // Painting
    private int _brush = 4;
    private int _paintLevel;
    private bool _painting;
    private string _preset = "";
    private string _newPresetName = "";
    private string? _presetMessage;
    private bool _presetMessageIsError;
    private string _text = "HELLO";
    private int _startWeek = 3;

    // Status
    private bool _busy;
    private string? _status;
    private string? _error;
    private string? _resultUrl;
    private CancellationTokenSource? _cts;

    private int PixelCount => _grid.Pixels().Count();
    private int TotalCommits => _grid.Pixels().Sum(p => p.Level) * Math.Max(1, _multiplier);

    private bool CanPush => _connected && !_busy && PixelCount > 0
                            && !string.IsNullOrWhiteSpace(_repository)
                            && !string.IsNullOrWhiteSpace(_authorEmail);

    protected override void OnInitialized()
    {
        _preset = Store.Presets[0].Name;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _themeMode = await JS.InvokeAsync<string>("contributionArt.getThemeMode");
            StateHasChanged();
        }
    }

    private async Task OnThemeModeChangedAsync(ChangeEventArgs args)
    {
        _themeMode = args.Value?.ToString() ?? DefaultThemeMode;
        await JS.InvokeVoidAsync("contributionArt.setThemeMode", _themeMode);
    }

    private void StartPaint(int week, int day)
    {
        _painting = true;
        _paintLevel = _grid.Get(week, day) == _brush ? 0 : _brush;
        _grid.Set(week, day, _paintLevel);
    }

    private void ContinuePaint(int week, int day)
    {
        if (_painting)
        {
            _grid.Set(week, day, _paintLevel);
        }
    }

    private void StopPaint() => _painting = false;

    private void StampPreset()
    {
        var preset = FindPreset(_preset);
        if (preset is not null)
        {
            _grid.Stamp(preset.Pattern, GetStampWeekIndex());
        }
    }

    private void SavePreset()
    {
        try
        {
            var name = _newPresetName.Trim();
            Store.SaveUserPreset(name, _grid.ToPattern());
            _preset = name;
            _newPresetName = "";
            ShowPresetMessage($"Saved preset “{name}”.", isError: false);
        }
        catch (PresetStoreException ex)
        {
            ShowPresetMessage(ex.Message, isError: true);
        }
    }

    private void ReloadPresets()
    {
        try
        {
            Store.ReloadUserPresets();
            if (FindPreset(_preset) is null)
            {
                _preset = Store.Presets[0].Name;
            }

            ShowPresetMessage($"Reloaded. {Store.Presets.Count} presets available.", isError: false);
        }
        catch (PresetStoreException ex)
        {
            ShowPresetMessage(ex.Message, isError: true);
        }
    }

    private Preset? FindPreset(string name)
    {
        foreach (var preset in Store.Presets)
        {
            if (preset.Name == name)
            {
                return preset;
            }
        }

        return null;
    }

    private void ShowPresetMessage(string message, bool isError)
    {
        _presetMessage = message;
        _presetMessageIsError = isError;
    }

    private void StampText()
    {
        _grid.Stamp(Presets.Text(_text, _brush == 0 ? 4 : _brush), GetStampWeekIndex(), skipZeros: true);
    }

    private int GetStampWeekIndex()
    {
        return Math.Clamp(_startWeek, 1, ContributionGrid.Weeks) - 1;
    }

    private async Task ConnectAsync()
    {
        await RunAsync("Connecting…", async ct =>
        {
            var user = await GitHub.GetUserAsync(_token.Trim(), ct);
            _owner = user.Login;
            _authorName = user.Name ?? user.Login;
            _authorEmail = user.NoReplyEmail;
            _maxDaily = await GitHub.GetMaxDailyContributionsAsync(_token.Trim(), user.Login, ct);
            _multiplier = Math.Max(1, (int)Math.Ceiling(_maxDaily / 4.0));
            _connected = true;
            _status = $"Connected as {user.Login}.";
        });
    }

    private async Task PushAsync()
    {
        _resultUrl = null;
        await RunAsync("Checking repository…", async ct =>
        {
            var token = _token.Trim();
            var repo = _repository.Trim();

            if (!await GitHub.IsRepositoryEmptyAsync(token, _owner, repo, ct))
            {
                throw new InvalidOperationException(
                    $"{_owner}/{repo} already has commits. Use a new, empty repository so nothing real gets overwritten.");
            }

            var progress = new Progress<string>(message =>
            {
                _status = message;
                _ = InvokeAsync(StateHasChanged);
            });

            var request = new PushRequest(_owner, repo, token, _authorName, _authorEmail,
                _grid.StartDate.AddDays(-1), BuildPlan());

            var count = await Pusher.PushAsync(request, progress, ct);
            _status = $"Pushed {count} commits.";
            _resultUrl = $"https://github.com/{_owner}/{repo}";
        });
    }

    private async Task DownloadScriptAsync()
    {
        var script = ScriptExporter.Bash(_owner, _repository.Trim(), _authorName, _authorEmail,
            _grid.StartDate.AddDays(-1), BuildPlan());
        await JS.InvokeVoidAsync("contributionArt.download", "contribution-art.sh", script);
    }

    private List<CommitPlanItem> BuildPlan() =>
        _grid.Pixels().Select(p => new CommitPlanItem(p.Date, p.Level * Math.Max(1, _multiplier))).ToList();

    private async Task RunAsync(string startMessage, Func<CancellationToken, Task> action)
    {
        _busy = true;
        _error = null;
        _status = startMessage;
        _cts = new CancellationTokenSource();
        try
        {
            await action(_cts.Token);
        }
        catch (OperationCanceledException)
        {
            _status = "Cancelled. Nothing was pushed.";
        }
        catch (Exception ex)
        {
            _status = null;
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            _cts.Dispose();
            _cts = null;
        }
    }

    private string MonthLabel(int week)
    {
        var sunday = _grid.DateAt(week, 0);
        return sunday.Day <= 7 ? sunday.ToString("MMM", CultureInfo.InvariantCulture) : "";
    }

    private static string WeekNumberLabel(int week)
    {
        var number = week + 1;
        if (number == 1 || number % 10 == 0)
        {
            return number.ToString(CultureInfo.InvariantCulture);
        }

        return "";
    }

    private string CellTitle(int week, int day, int level, bool future)
    {
        var date = _grid.DateAt(week, day).ToString("ddd d MMM yyyy", CultureInfo.InvariantCulture);
        return future ? $"{date} (future)" : $"{date}: level {level}, {level * Math.Max(1, _multiplier)} commits";
    }

    public void Dispose() => _cts?.Cancel();
}
