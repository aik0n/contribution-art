<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Application Packages -->
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
    <!-- Test Packages -->
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <!-- FluentAssertions stays on 7.x: 8.x and later need a paid licence for commercial use. -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- The mtp-off variant runs under VSTest, the default for dotnet test on the .NET 10 SDK. -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <!-- Analysis Packages -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
  </ItemGroup>
</Project>